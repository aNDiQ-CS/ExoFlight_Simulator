  cues:
  - id: S0-01
    stage: "0. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
    condition: "\u041F\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0435
      \u043C\u0438\u0441\u0441\u0438\u0438"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s0_01_ai.wav
    text: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418 \u043D\u0430
      \u0441\u0432\u044F\u0437\u0438. \u0421\u0438\u0441\u0442\u0435\u043C\u044B
      \u0432 \u043D\u043E\u0440\u043C\u0435, \u0437\u0430\u0440\u044F\u0434 \u2014
      \u0441\u0442\u043E \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432."
    demo: 1
    estimatedSeconds: 4.3
    audio: {fileID: 8300000, guid: 144e1514b9f242ef874a887c87b38495, type: 3}
  - id: S0-02
    stage: "0. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
    condition: "\u041F\u0435\u0440\u0435\u0434 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0432\u0437\u043B\u0451\u0442\u043E\u043C \u0438\u0433\u0440\u043E\u043A\u0430"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s0_02_ai.wav
    text: "\u0415\u0441\u043B\u0438 \u0437\u0430\u043A\u0440\u0443\u0436\u0438\u0442\u0441\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430 \u2014 \u0441\u043A\u0430\u0436\u0438\u0442\u0435
      \u043E\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0443, \u043F\u043E\u043B\u0451\u0442
      \u0441\u0440\u0430\u0437\u0443 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442."
    demo: 1
    estimatedSeconds: 3.5
    audio: {fileID: 8300000, guid: a30f56490cc84af49692eae9f244fc37, type: 3}
  - id: S0-03
    stage: "0. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
    condition: "\u0411\u0440\u0438\u0444\u0438\u043D\u0433, \u043F\u043E\u0441\u043B\u0435
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F \u0418\u0418"
    speaker: "\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440"
    fileName: vo_s0_03_cmd.wav
    text: "\u041E\u043F\u0435\u0440\u0430\u0442\u043E\u0440, \u043D\u0430 \u0441\u0432\u044F\u0437\u0438,
      \u0431\u0430\u0437\u0430. \u0412 \u0432\u043E\u0441\u044C\u043C\u0438\u0441\u0442\u0430\u0445
      \u043C\u0435\u0442\u0440\u0430\u0445 \u043A \u0432\u043E\u0441\u0442\u043E\u043A\u0443
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434,
      \u0430 \u043A \u0440\u0430\u0439\u043E\u043D\u0443 \u0438\u0434\u0451\u0442
      \u043F\u044B\u043B\u0435\u0432\u0430\u044F \u0431\u0443\u0440\u044F. \u0417\u0430\u0431\u0438\u0440\u0430\u0435\u043C
      \u0435\u0433\u043E \u0438 \u0432\u0435\u0434\u0451\u043C \u043D\u0430 \u0442\u043E\u0447\u043A\u0443
      \u043F\u043E\u0441\u0430\u0434\u043A\u0438."
    demo: 1
    estimatedSeconds: 10.4
    audio: {fileID: 8300000, guid: a197835ed3074515bbe13309f4d696d4, type: 3}
  - id: S0-04
    stage: "0. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
    condition: "\u041E\u0431\u0440\u0430\u0442\u043D\u044B\u0439 \u043E\u0442\u0441\u0447\u0451\u0442"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s0_04_ai.wav
    text: "\u0412\u0437\u043B\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438\u2026
      \u0434\u0432\u0430\u2026 \u043E\u0434\u0438\u043D\u2026"
    demo: 1
    estimatedSeconds: 2.2
    audio: {fileID: 8300000, guid: 6c75795be3ae4119a85ee884d8a9ae75, type: 3}
  - id: S0-05
    stage: "0. \u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0430"
    condition: "\u041F\u043E\u0441\u043B\u0435 \u043E\u0442\u0441\u0447\u0451\u0442\u0430"
    speaker: "\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440"
    fileName: vo_s0_05_cmd.wav
    text: "\u0412\u0437\u043B\u0451\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u044E.
      \u0423\u0434\u0430\u0447\u0438."
    demo: 1
    estimatedSeconds: 1.3
    audio: {fileID: 8300000, guid: 661c4fffda194c4481623dc4e14537b7, type: 3}
  - id: S1-01
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0427\u0435\u0440\u0435\u0437 2 \u0441 \u043F\u043E\u0441\u043B\u0435
      \u0432\u0437\u043B\u0451\u0442\u0430"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_01_ai.wav
    text: "\u0413\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044F \u0437\u0434\u0435\u0441\u044C
      \u2014 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0432\u043E\u0441\u0435\u043C\u044C
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0437\u0435\u043C\u043D\u043E\u0439,
      \u043D\u043E \u0432\u043E\u0437\u0434\u0443\u0445 \u043F\u043E\u0447\u0442\u0438
      \u043D\u0435 \u0434\u0435\u0440\u0436\u0438\u0442. \u0413\u0430\u0437 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435
      \u043F\u043B\u0430\u0432\u043D\u043E."
    demo: 1
    estimatedSeconds: 6.1
    audio: {fileID: 8300000, guid: 4fafe2dc346149cfbe489c787e31f3bc, type: 3}
  - id: S1-02
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0418\u0433\u0440\u043E\u043A \u043D\u0435 \u0432\u0437\u043B\u0435\u0442\u0430\u0435\u0442
      10 \u0441"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_02_ai.wav
    text: "\u041B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u0432\u0435\u0440\u0445
      \u2014 \u043D\u0430\u0431\u043E\u0440 \u0432\u044B\u0441\u043E\u0442\u044B."
    demo: 1
    estimatedSeconds: 2.2
    audio: {fileID: 8300000, guid: 2f3ce9ca92b24b20a517fccf6ce019f5, type: 3}
  - id: S1-03
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0418\u0433\u0440\u043E\u043A \u0432\u0438\u0441\u0438\u0442 \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435 10 \u0441"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_03_ai.wav
    text: "\u041F\u0440\u0430\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442
      \u0434\u0440\u043E\u043D. \u041A\u0443\u0434\u0430 \u043D\u0430\u043A\u043B\u043E\u043D\u0438\u0442\u0435
      \u2014 \u0442\u0443\u0434\u0430 \u0438 \u043F\u043E\u043B\u0435\u0442\u0438\u0442\u0435."
    demo: 1
    estimatedSeconds: 3.9
    audio: {fileID: 8300000, guid: 0205590eb0d54044a326f7334b49cffc, type: 3}
  - id: S1-04
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0418\u0433\u0440\u043E\u043A \u043D\u0435 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B
      20 \u0441"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_04_ai.wav
    text: "\u041B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u043B\u0435\u0432\u043E
      \u0438 \u0432\u043F\u0440\u0430\u0432\u043E \u2014 \u0440\u0430\u0437\u0432\u043E\u0440\u043E\u0442
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435."
    demo: 0
    estimatedSeconds: 3.5
    audio: {fileID: 8300000, guid: 8dfc466b3bcb43cab24c7ffb2f47fd7d, type: 3}
  - id: S1-05
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0417\u0430\u0432\u0438\u0441\u0430\u043D\u0438\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E
      3 \u0441"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_05_ai.wav
    text: "\u0417\u0430\u0432\u0438\u0441\u0430\u043D\u0438\u0435 \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u043E\u0435.
      \u0425\u043E\u0440\u043E\u0448\u043E \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F."
    demo: 0
    estimatedSeconds: 1.7
    audio: {fileID: 8300000, guid: 8aef67187225496b81065e1bb4e7774f, type: 3}
  - id: S1-06
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u041F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043C\u0430\u0440\u043A\u0435\u0440
      \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0430"
    speaker: "\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440"
    fileName: vo_s1_06_cmd.wav
    text: "\u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u043C \u043C\u0430\u0440\u043A\u0435\u0440
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435. \u0414\u0435\u0440\u0436\u0438\u043C
      \u043A\u0443\u0440\u0441 \u043D\u0430 \u043D\u0435\u0433\u043E."
    demo: 1
    estimatedSeconds: 3.5
    audio: {fileID: 8300000, guid: 36a8dff561a842b5af1162d168432765, type: 3}
  - id: S1-07
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0411\u044B\u0441\u0442\u0440\u043E\u0435 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435
      \u0443 \u0437\u0435\u043C\u043B\u0438"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_07_ai.wav
    text: "\u0421\u043D\u0438\u0436\u0430\u0435\u0442\u0435\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0431\u044B\u0441\u0442\u0440\u043E. \u0414\u043E\u0431\u0430\u0432\u044C\u0442\u0435
      \u0433\u0430\u0437."
    demo: 1
    estimatedSeconds: 2.2
    audio: {fileID: 8300000, guid: c8eb2b33314c40d388628118b6bee9da, type: 3}
  - id: S1-08
    stage: "1. \u0421\u0442\u0430\u0440\u0442"
    condition: "\u0418\u0433\u0440\u043E\u043A \u0443\u0448\u0451\u043B \u043E\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043D\u0430 20 \u0441"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s1_08_cmd.wav
    text: "\u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u041C\u0430\u0440\u0441\u043E\u0445\u043E\u0434 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435."
    demo: 0
    estimatedSeconds: 3
    audio: {fileID: 8300000, guid: c8fa6b5012a544458dfc9b87271abcd3, type: 3}
  - id: S2-01
    stage: "2. \u041A \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0443"
    condition: "\u0412\u0445\u043E\u0434 \u0432 \u0437\u043E\u043D\u0443 \u044D\u0442\u0430\u043F\u0430"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s2_01_ai.wav
    text: "\u0424\u0438\u043A\u0441\u0438\u0440\u0443\u044E \u0444\u0440\u043E\u043D\u0442
      \u043F\u044B\u043B\u0435\u0432\u043E\u0439 \u0431\u0443\u0440\u0438 \u043D\u0430
      \u0441\u0435\u0432\u0435\u0440\u043E-\u0437\u0430\u043F\u0430\u0434\u0435.
      \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0432\u0435\u0442\u0440\u0430
      \u0440\u0430\u0441\u0442\u0451\u0442."
    demo: 1
    estimatedSeconds: 3.9
    audio: {fileID: 8300000, guid: 93941dcb2e314f69813ca74c723afb45, type: 3}
  - id: S2-02
    stage: "2. \u041A \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0443"
    condition: "\u041F\u043E\u0441\u043B\u0435 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439
      \u0440\u0435\u043F\u043B\u0438\u043A\u0438"
    speaker: "\u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440"
    fileName: vo_s2_02_cmd.wav
    text: "\u0421\u0440\u043E\u0447\u043D\u043E, \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u043C
      \u0433\u0440\u0443\u0437 \u0438 \u0443\u0445\u043E\u0434\u0438\u043C \u043A
      \u043A\u0430\u043D\u044C\u043E\u043D\u0443."
    demo: 1
    estimatedSeconds: 3
    audio: {fileID: 8300000, guid: 9011ca4d32e04a109df0e1b875de4284, type: 3}
  - id: S2-03
    stage: "2. \u041A \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0443"
    condition: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u0440\u044B\u0432
      \u0432\u0435\u0442\u0440\u0430"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s2_03_ai.wav
    text: "\u0411\u043E\u043A\u043E\u0432\u043E\u0439 \u043F\u043E\u0440\u044B\u0432.
      \u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u043A\u0443\u0440\u0441."
    demo: 1
    estimatedSeconds: 1.7
    audio: {fileID: 8300000, guid: 92b257fbf634480daf6117d1ae71f259, type: 3}
  - id: S2-04
    stage: "2. \u041A \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0443"
    condition: "\u0414\u043E \u043C\u0430\u0440\u0441\u043E\u0445\u043E\u0434\u0430
      50 \u043C"
    speaker: "\u0411\u043E\u0440\u0442\u043E\u0432\u043E\u0439 \u0418\u0418"
    fileName: vo_s2_04_ai.wav
    text: "\u041C\u0430\u0440\u0441\u043E\u0445\u043E\u0434 \u0432 \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438
