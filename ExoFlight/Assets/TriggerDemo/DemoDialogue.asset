  lines:
  - speaker: "\u0426\u0435\u043D\u0442\u0440 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
    text: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0441\u0432\u044F\u0437\u0438.
      \u0414\u0440\u043E\u043D, \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435
      \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C."
    audio: {fileID: 8300000, guid: 5696c66748d440f438e279b3bd4e1fbe, type: 3}
    pauseAfter: 0.4
  - speaker: "\u0414\u0440\u043E\u043D"
    text: "\u0421\u0432\u044F\u0437\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430.
      \u0413\u043E\u0442\u043E\u0432 \u043A \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044E
      \u0437\u0430\u0434\u0430\u043D\u0438\u044F."
    audio: {fileID: 8300000, guid: 76d116e36a9993844888a3e8e04b4ead, type: 3}
